{
  "id": "wealthfolio-technical-analysis",
  "name": "Technical Analysis",
  "version": "1.0.1",
  "description": "持倉技術分析、成本線、買賣紀錄與每日收盤移動停利提醒",
  "author": "juicheng",
  "main": "dist/addon.js",
  "sdkVersion": "3.8.0",
  "minWealthfolioVersion": "3.8.0",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "tech-analysis"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "tech-analysis",
          "route": "tech-analysis",
          "label": "Technical Analysis",
          "icon": "line-chart",
          "order": 100
        }
      ]
    }
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": [
        "getAll"
      ],
      "purpose": "Read available accounts to load portfolio holdings"
    },
    {
      "category": "portfolio",
      "functions": [
        "getHoldings"
      ],
      "purpose": "Read user holdings to display technical analysis overview"
    },
    {
      "category": "network",
      "functions": [
        "request"
      ],
      "purpose": "Fetch historical and latest daily stock prices from Yahoo Finance"
    },
    {
      "category": "activities",
      "functions": [
        "getAll"
      ],
      "purpose": "Read buy and sell history to mark actual trades on stock charts"
    }
  ],
  "network": {
    "allowedHosts": [
      "query1.finance.yahoo.com",
      "query2.finance.yahoo.com"
    ]
  }
}
