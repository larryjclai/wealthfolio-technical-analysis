{
  "name": "wealthfolio-technical-analysis",
  "version": "1.0.1",
  "description": "Technical Analysis Addon for Wealthfolio",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "dev:server": "wealthfolio-addon dev",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "test": "vitest run",
    "preview:fixtures": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "lightweight-charts": "^4.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@wealthfolio/addon-dev-tools": "^3.8.0",
    "@wealthfolio/addon-sdk": "latest",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "pnpm"
    ]
  }
}
